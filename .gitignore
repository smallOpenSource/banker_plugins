# --- OMC / OMX / session runtime state (machine-specific, do not publish) ---
# .omc/ also covers obsidizer's runtime artifacts: .omc/wiki/.obsidizer (the --enable flag),
# .obsidizer-hook.log, .obsidizer-state.json, and any .omc/wiki.bak-<ts> snapshot.
.omc/
.omx/
.remember/

# --- Agent-harness local config ---
# settings.local.json is per-machine. A project-shared .claude/settings.json is deliberately NOT
# ignored — never widen this to .claude/, or a shared config would be silently dropped one day.
# (.claude-plugin/ is the published plugin manifest and stays tracked.)
.claude/settings.local.json

# --- npm build artifacts (`npm pack` drops the tarball in the repo root) ---
node_modules/
*.tgz

# --- Python caches ---
__pycache__/
*.py[cod]

# --- Logs & runtime artifacts ---
*.log
# ultra-init-workspace = runtime output dir (no SKILL.md), not a publishable skill
skills/ultra-init-workspace/

# --- Local git credential store (token-scoped auth option) ---
.banker-credentials
.git-credentials

# --- OS cruft ---
.DS_Store
Thumbs.db

# Codex project-scope install (banker setup --codex --scope project)
.codex/

# local-only npm publish helper (do not commit/publish)
scripts/publish_npm.sh

# build-knowledge wiki (local-only; lives at build_plugin/wiki_docs) — never commit/publish
wiki_docs/

USER_RESOURCES/

